# ========================================================
# ManaAgenda RAG Chatbot - Environment Variables Template
# ========================================================

# Google Gemini API key (Required)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (Required for production)
# Comma-separated list of allowed frontend URLs (no trailing slash).
# Example: https://manaagenda.vercel.app,https://www.manaagenda.com,http://localhost:3000
ALLOWED_ORIGINS=https://manaagenda.vercel.app

# Gemini Models & Timeout Configuration (Optional, defaults shown below)
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_MS=20000

# Cloud Vector DB: Upstash Vector (Optional for read-only bundled mode, Recommended for dynamic uploads in serverless production)
# Sign up at https://console.upstash.com/
# UPSTASH_VECTOR_REST_URL=https://your-index-url.upstash.io
# UPSTASH_VECTOR_REST_TOKEN=your_token_here
